# ---- Database ----
DATABASE_URL="mysql://prospector:prospector@localhost:3306/prospector"

# ---- Server ----
PORT=4023
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ---- Auth ----
# Generate a strong random value in production, e.g. `openssl rand -hex 32`
JWT_SECRET="dev-insecure-secret-change-me"
JWT_EXPIRES_IN=7d
COOKIE_NAME=prospector_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# ---- CORS ----
# Only needed if the SPA is served from a different origin than the API.
# In dev the CRA proxy makes requests same-origin, so this can stay empty.
# Example for cross-origin dev: CORS_ORIGIN=http://localhost:3023
CORS_ORIGIN=

# ---- Domain ----
ORG_ID=org-1
SEED_DEMO_PASSWORD=demo1234
