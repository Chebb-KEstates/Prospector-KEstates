# Docker Compose configuration. Copy to `.env` and adjust for your environment.

# ---- Database ----
# Used directly by the `server` container.
#
# Local/dev, bundled MySQL (run with:
#   docker compose -f docker-compose.yml -f docker-compose.local-db.yml up --build):
#   DATABASE_URL=mysql://prospector:prospector@db:3306/prospector
#
# Deploying against a MySQL server you already have (run with just:
#   docker compose up --build):
#   DATABASE_URL=mysql://user:password@your-db-host:3306/prospector
DATABASE_URL=mysql://prospector:prospector@db:3306/prospector

# ---- MySQL (only used by docker-compose.local-db.yml) ----
MYSQL_DATABASE=prospector
MYSQL_USER=prospector
MYSQL_PASSWORD=prospector
MYSQL_ROOT_PASSWORD=rootpassword
# Host port for MySQL (3306 is often already in use locally).
MYSQL_PORT=3307

# ---- Backend ----
SERVER_PORT=4023
# CHANGE THIS in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ORG_ID=org-1
SEED_DEMO_PASSWORD=demo1234
BCRYPT_ROUNDS=12

# ---- Frontend (nginx) ----
WEB_PORT=3023
# Also picked up by `npm start` (CRA dev server) when running the frontend
# outside Docker.
PORT=3023
