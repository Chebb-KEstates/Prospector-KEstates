# Copy to server/.env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Origin allowed to call the API with credentials (the CRA dev server).
CORS_ORIGIN=http://localhost:3000

# ── MySQL ───────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prospector
DB_PASSWORD=
DB_NAME=prospector
DB_CONNECTION_LIMIT=10

# ── Sessions ────────────────────────────────────────────────────────────
# Cookies are httpOnly. COOKIE_SECURE also flips sameSite: false → Strict (plain
# http://localhost, frontend and API share a site); true → None (required
# whenever the frontend and API are on different hostnames — a reverse proxy,
# or a cloud dev environment that forwards each port to its own subdomain —
# since that makes every request "cross-site" and Strict/Lax cookies never
# arrive; None requires HTTPS, which is why it's tied to COOKIE_SECURE).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# ── Bootstrap ───────────────────────────────────────────────────────────
# Used once by `npm run seed` to create the first manager account.
BOOTSTRAP_MANAGER_EMAIL=director@demo.ae
BOOTSTRAP_MANAGER_NAME=The Director
BOOTSTRAP_MANAGER_PASSWORD=12345@@67890

# Seed synthetic demo data (owners/leads/calls). Never enable with real data.
SEED_DEMO_DATA=true

# ── Uploads ─────────────────────────────────────────────────────────────
# Import files are parsed then discarded — never written to disk.
MAX_UPLOAD_BYTES=26214400
IMPORT_SESSION_TTL_MINUTES=60
