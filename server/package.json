{
  "name": "prospector-server",
  "version": "3.4.3",
  "private": true,
  "description": "Prospector backend — Fastify + MySQL. Owns persistence, auth, permissions, masking and audit.",
  "main": "dist/server/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "diagnose:units": "tsx src/db/diagnose-unit-collisions.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "node --test --test-concurrency=1 --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "mysql2": "^3.11.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
